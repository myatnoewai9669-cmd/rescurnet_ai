                                stroke="<?= $result['risk_level'] === 'critical' ? '#ff3b3b' : ($result['risk_level'] === 'high' ? '#ff9500' : ($result['risk_level'] === 'medium' ? '#ffd60a' : '#34c759')) ?>"
