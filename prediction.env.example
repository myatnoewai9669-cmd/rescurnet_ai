</main>

<script>
function updateSlider(input, sliderId) {
    document.getElementById(sliderId).value = input.value;
    updateLabel(sliderId, input.value, input.name);
}
function updateInput(slider, inputId) {
    document.getElementById(inputId).value = slider.value;
    updateLabel(slider.id, slider.value, document.getElementById(inputId).name);
}
function updateLabel(sliderId, val, name) {
    const labels = { rs:'rv', ws:'wv', hs:'hv', ts:'tv' };
    const units  = { rainfall:'mm', wind_speed:'km/h', humidity:'%', temperature:'°C' };
    const labelId = labels[sliderId];
    if (labelId) document.getElementById(labelId).textContent = val + ' ' + (units[name] || '');
}

document.getElementById('predForm').addEventListener('submit', function () {
    const btn = document.getElementById('analyzeBtn');
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Analyzing...';
    btn.disabled  = true;
});
</script>
</body>
</html>
