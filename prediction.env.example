<?php
session_start();

// ── Load .env ──────────────────────────────────────────────────────────────
function loadEnv(string $path): void {
    if (!file_exists($path)) return;
    foreach (file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        if (str_starts_with(trim($line), '#')) continue;
        [$key, $val] = explode('=', $line, 2);
        $_ENV[trim($key)] = trim($val);
    }
}
loadEnv(__DIR__ . '/.env');

require_once 'config.db.php';

// Handle AI Prediction form submit
$result = null;
$error  = null;

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $country      = $_POST['country']      ?? '';
    $region       = $_POST['region']       ?? '';
    $disaster_type = $_POST['disaster_type'] ?? '';
    $rainfall     = $_POST['rainfall']     ?? 0;
    $wind_speed   = $_POST['wind_speed']   ?? 0;
    $humidity     = $_POST['humidity']     ?? 0;
    $temperature  = $_POST['temperature']  ?? 0;
    $river_level  = $_POST['river_level']  ?? 'normal';

    // Build AI prompt
    $prompt = "You are a disaster risk assessment AI for ASEAN region. Analyze the following weather data and provide a flood/disaster risk assessment.

Location: $country, $region
Disaster Type: $disaster_type
Weather Data:
- Rainfall: {$rainfall}mm in last 24 hours
- Wind Speed: {$wind_speed} km/h
- Humidity: {$humidity}%
- Temperature: {$temperature}°C
- River/Water Level: $river_level

Based on this data, provide:
1. Risk Score (0-100)
2. Risk Level (low/medium/high/critical)
3. Confidence percentage
4. Brief reasoning (2-3 sentences)
5. Recommended actions (3 bullet points)

Respond in this exact JSON format:
{
  \"risk_score\": 75,
  \"risk_level\": \"high\",
  \"confidence\": 82,
  \"reasoning\": \"Your reasoning here.\",
  \"actions\": [\"Action 1\", \"Action 2\", \"Action 3\"]
}";

    // ── Hugging Face API — token from .env ────────────────────────────────
    $hf_token = $_ENV['HUGGINGFACE_API_KEY'] ?? '';

    $ch = curl_init();
    curl_setopt_array($ch, [
        CURLOPT_URL            => 'https://api-inference.huggingface.co/models/mistralai/Mixtral-8x7B-Instruct-v0.1',
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_POST           => true,
        CURLOPT_HTTPHEADER     => [
            'Authorization: Bearer ' . $hf_token,
            'Content-Type: application/json',
        ],
        CURLOPT_POSTFIELDS => json_encode([
            'inputs'     => $prompt,
            'parameters' => [
                'max_new_tokens'   => 400,
                'temperature'      => 0.3,
                'return_full_text' => false,
            ],
        ]),
        CURLOPT_TIMEOUT => 30,
    ]);

    $response  = curl_exec($ch);
    $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    // ── Helper: save prediction to DB ─────────────────────────────────────
    $saveWeather = json_encode([
        'rainfall'    => $rainfall,
        'wind_speed'  => $wind_speed,
        'humidity'    => $humidity,
        'temperature' => $temperature,
        'river_level' => $river_level,
    ]);

    $savePrediction = function (
        $risk_score, $risk_level, $confidence, $reasoning
    ) use ($pdo, $country, $region, $disaster_type, $saveWeather) {
        $stmt = $pdo->prepare(
            "INSERT INTO ai_predictions
             (country, region, disaster_type, risk_score, risk_level, confidence, ai_reasoning, weather_data)
             VALUES (?,?,?,?,?,?,?,?)"
        );
        $stmt->execute([
            $country, $region, $disaster_type,
            $risk_score, $risk_level, $confidence, $reasoning, $saveWeather,
        ]);
    };

    // ── Rule-based score helper ───────────────────────────────────────────
    $ruleScore = function () use ($rainfall, $humidity, $wind_speed, $river_level) {
        $s = 0;
        if ($rainfall   > 100) $s += 35; elseif ($rainfall  > 50) $s += 20; elseif ($rainfall  > 20) $s += 10;
        if ($humidity   > 90)  $s += 20; elseif ($humidity  > 75) $s += 10;
        if ($wind_speed > 100) $s += 25; elseif ($wind_speed > 60) $s += 15;
        if ($river_level === 'critical') $s += 30;
        elseif ($river_level === 'high')     $s += 20;
        elseif ($river_level === 'elevated') $s += 10;
        return min(100, $s);
    };

    $levelFromScore = fn($s) =>
        $s >= 75 ? 'critical' : ($s >= 50 ? 'high' : ($s >= 25 ? 'medium' : 'low'));

    $defaultActions = [
        'Monitor weather updates every 2 hours',
        'Prepare evacuation plan for high-risk zones',
        'Alert local disaster response teams',
    ];

    // ── Process API response ──────────────────────────────────────────────
    if ($http_code === 200) {
        $data = json_decode($response, true);
        $text = $data[0]['generated_text'] ?? '';

        preg_match('/\{[^{}]*\}/s', $text, $matches);

        if (!empty($matches[0]) && ($ai_result = json_decode($matches[0], true))) {
            $risk_score = $ai_result['risk_score'] ?? 50;
            $risk_level = $ai_result['risk_level'] ?? 'medium';
            $confidence = $ai_result['confidence'] ?? 70;
            $reasoning  = $ai_result['reasoning']  ?? 'Analysis complete.';
            $actions    = $ai_result['actions']     ?? [];

            $savePrediction($risk_score, $risk_level, $confidence, $reasoning);
            $result = compact('risk_score','risk_level','confidence','reasoning','actions','country','region','disaster_type');

        } else {
            // Fallback: rule-based
            $risk_score = $ruleScore();
            $risk_level = $levelFromScore($risk_score);
            $confidence = 65;
            $reasoning  = "Rule-based assessment: Rainfall of {$rainfall}mm with {$humidity}% humidity and {$river_level} river level indicates {$risk_level} risk for {$disaster_type} in {$region}, {$country}.";
            $actions    = $defaultActions;

            $savePrediction($risk_score, $risk_level, $confidence, $reasoning);
            $result = compact('risk_score','risk_level','confidence','reasoning','actions','country','region','disaster_type');
        }

    } else {
        // API failed — rule-based fallback
        $risk_score = min(100,
            ($rainfall   > 80 ? 40 : 20) +
            ($humidity   > 85 ? 20 : 10) +
            ($wind_speed > 80 ? 20 :  5)
        );
        $risk_level = $levelFromScore($risk_score);
        $confidence = 60;
        $reasoning  = "Offline assessment based on weather parameters. Rainfall {$rainfall}mm and humidity {$humidity}% suggest {$risk_level} risk in {$region}, {$country}.";
        $actions    = ['Stay updated with local weather alerts', 'Identify nearest evacuation centers', 'Keep emergency supplies ready'];

        $result = compact('risk_score','risk_level','confidence','reasoning','actions','country','region','disaster_type');
    }
}

// Fetch past predictions
$history = $pdo->query("SELECT * FROM ai_predictions ORDER BY predicted_at DESC LIMIT 10")->fetchAll();
?>
