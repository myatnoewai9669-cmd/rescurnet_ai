<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="assets/js/map.js"></script>
<script>
const miniMap = L.map('mini-map').setView([10.0, 110.0], 4);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(miniMap);

const disasters = <?= json_encode($disasters) ?>;
disasters.forEach(d => {
    const color = d.severity === 'critical' ? 'red' : d.severity === 'high' ? 'orange' : 'yellow';
    const icon = L.divIcon({
        html: `<div style="background:${color};width:14px;height:14px;border-radius:50%;border:2px solid white;"></div>`,
        iconSize: [14, 14]
    });
    L.marker([d.latitude, d.longitude], { icon })
        .bindPopup(`<b>${d.title}</b><br>${d.country} — ${d.severity.toUpperCase()}`)
        .addTo(miniMap);
});
</script>
