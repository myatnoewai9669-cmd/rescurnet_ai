<?php
session_start();

// ── Load .env ──────────────────────────────────────────────────────────────
function loadEnv(string $path): void {
    if (!file_exists($path)) return;
    foreach (file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        if (str_starts_with(trim($line), '#')) continue;
        [$key, $val] = explode('=', $line, 2);
        $_ENV[trim($key)] = trim($val);
    }
}
loadEnv(__DIR__ . '/.env');

// ── Live Weather ────────────────────────────────────────────────────────────
$weather_data = [];
$api_key = $_ENV['OPENWEATHER_API_KEY'] ?? '';
$cities = [
    ['name'=>'Yangon',   'lat'=>16.8409, 'lon'=>96.1735],
    ['name'=>'Mandalay', 'lat'=>21.9588, 'lon'=>96.0891],
    ['name'=>'Manila',   'lat'=>14.5995, 'lon'=>120.9842],
    ['name'=>'Bangkok',  'lat'=>13.7563, 'lon'=>100.5018],
];

foreach ($cities as $city) {
    $url = "https://api.openweathermap.org/data/2.5/weather?lat={$city['lat']}&lon={$city['lon']}&appid={$api_key}&units=metric";
    $ch = curl_init();
    curl_setopt_array($ch, [
        CURLOPT_URL            => $url,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT        => 5,
    ]);
    $res  = curl_exec($ch);
    $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    if ($code === 200) {
        $d = json_decode($res, true);
        $weather_data[] = [
            'city'     => $city['name'],
            'temp'     => round($d['main']['temp']),
            'humidity' => $d['main']['humidity'],
            'wind'     => round($d['wind']['speed'] * 3.6),
            'rain'     => $d['rain']['1h'] ?? 0,
            'desc'     => $d['weather'][0]['description'],
            'icon'     => $d['weather'][0]['icon'],
        ];
    }
}

require_once 'config.db.php';

// ── DB Queries ──────────────────────────────────────────────────────────────
$disasters   = $pdo->query("SELECT * FROM disasters WHERE status = 'active' ORDER BY created_at DESC")->fetchAll();
$alerts      = $pdo->query("SELECT a.*, d.type as disaster_type FROM alerts a LEFT JOIN disasters d ON a.disaster_id = d.id ORDER BY a.issued_at DESC LIMIT 5")->fetchAll();
$centers     = $pdo->query("SELECT * FROM evacuation_centers WHERE status = 'open'")->fetchAll();
$predictions = $pdo->query("SELECT * FROM ai_predictions ORDER BY predicted_at DESC LIMIT 6")->fetchAll();
?>
