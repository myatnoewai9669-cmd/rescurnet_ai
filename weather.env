<?php

// ── Load .env ──────────────────────────────────────────────────────────────
function loadEnv(string $path): void {
    if (!file_exists($path)) return;
    foreach (file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        if (str_starts_with(trim($line), '#')) continue;
        [$key, $val] = explode('=', $line, 2);
        $_ENV[trim($key)] = trim($val);
    }
}
loadEnv(__DIR__ . '/.env');

require_once 'config.db.php';

$api_key = $_ENV['OPENWEATHER_API_KEY'] ?? '';

$cities = [
    ['name'=>'Yangon',   'country'=>'Myanmar',      'lat'=>16.8409, 'lon'=>96.1735],
    ['name'=>'Mandalay', 'country'=>'Myanmar',      'lat'=>21.9588, 'lon'=>96.0891],
    ['name'=>'Sagaing',  'country'=>'Myanmar',      'lat'=>21.8830, 'lon'=>95.9820],
    ['name'=>'Manila',   'country'=>'Philippines',  'lat'=>14.5995, 'lon'=>120.9842],
    ['name'=>'Hanoi',    'country'=>'Vietnam',      'lat'=>21.0285, 'lon'=>105.8542],
    ['name'=>'Bangkok',  'country'=>'Thailand',     'lat'=>13.7563, 'lon'=>100.5018],
    ['name'=>'Jakarta',  'country'=>'Indonesia',    'lat'=>-6.2088, 'lon'=>106.8456],
];

$results = [];

foreach ($cities as $city) {
    $url = "https://api.openweathermap.org/data/2.5/weather?lat={$city['lat']}&lon={$city['lon']}&appid={$api_key}&units=metric";

    $ch = curl_init();
    curl_setopt_array($ch, [
        CURLOPT_URL            => $url,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT        => 10,
    ]);
    $response  = curl_exec($ch);
    $http_code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    if ($http_code === 200) {
        $data = json_decode($response, true);

        $weather = [
            'city'        => $city['name'],
            'country'     => $city['country'],
            'temperature' => $data['main']['temp'],
            'humidity'    => $data['main']['humidity'],
            'wind_speed'  => round($data['wind']['speed'] * 3.6, 1), // m/s → km/h
            'rainfall_mm' => $data['rain']['1h'] ?? 0,
            'pressure'    => $data['main']['pressure'],
            'description' => $data['weather'][0]['description'],
            'icon'        => $data['weather'][0]['icon'],
        ];

        // Save to DB
        $stmt = $pdo->prepare("INSERT INTO weather_logs
            (country, region, latitude, longitude, temperature, humidity, wind_speed, rainfall_mm, pressure_hpa)
            VALUES (?,?,?,?,?,?,?,?,?)");
        $stmt->execute([
            $city['country'], $city['name'],
            $city['lat'],     $city['lon'],
            $weather['temperature'], $weather['humidity'],
            $weather['wind_speed'],  $weather['rainfall_mm'],
            $weather['pressure'],
        ]);

        $results[] = $weather;
    }
}

header('Content-Type: application/json');
echo json_encode([
    'success'    => true,
    'data'       => $results,
    'updated_at' => date('Y-m-d H:i:s'),
]);
?>
